{
  // PaddleCue Realtime Database rules.
  // Paste into Firebase console > Realtime Database > Rules, then Publish.
  //
  // rooms/<roomId> = { owner: <anonymous uid>, t: <server time of last update>, state: <session> }
  // - Anyone with the link (the QR) can watch a room. Room ids are long and random, and rooms can't be listed.
  // - Only the phone that created a room can change or delete it.
  // - A room idle for 7 days can be deleted by any signed-in phone. The host's app retires its own
  //   week-old room; a daily server-side sweep for abandoned rooms is planned with the notification helper.
  //   (The query-based listing rule below is kept for that, but Firebase currently refuses it over REST.)
  "rules": {
    "rooms": {
      ".indexOn": ["t"],
      // the only listing allowed: rooms idle for over 7 days, so they can be cleaned up
      ".read": "auth != null && query.orderByChild === 't' && query.endAt <= now - 604800000",
      "$room": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === auth.uid) || (data.child('owner').val() === auth.uid && (!newData.exists() || newData.child('owner').val() === auth.uid)) || (!newData.exists() && data.child('t').val() < now - 604800000))",
        ".validate": "!newData.exists() || ($room.matches(/^[A-Za-z0-9]{16,32}$/) && newData.hasChildren(['owner', 't', 'state']) && newData.child('t').val() === now)"
      }
    },
    // everything else (including the old open "sessions" area) is closed
    "$other": { ".read": false, ".write": false }
  }
}
